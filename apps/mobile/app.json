{
  "expo": {
    "name": "EdgeEver",
    "slug": "edgeever",
    "scheme": "edgeever",
    "version": "1.54.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/59d2a8c8-fe8f-4e59-874f-a5887f584a20",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.edgeever.mobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "NSMicrophoneUsageDescription": "EdgeEver only uses the microphone if web content inside a note explicitly requests it.",
        "NSCameraUsageDescription": "Allow EdgeEver to use your camera to take photos and insert them into your notes."
      }
    },
    "android": {
      "package": "org.edgeever.mobile",
      "versionCode": 154,
      "adaptiveIcon": {
        "backgroundColor": "#16A06E",
        "backgroundImage": "./assets/icon.png",
        "foregroundImage": "./assets/adaptive-icon-transparent.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow EdgeEver to take photos and insert them into your notes.",
          "microphonePermission": false,
          "photosPermission": "Allow EdgeEver to choose photos to insert into your notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A06E",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "usesCleartextTraffic": true,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebPageWithMaxCount": 1,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "multipleShareMimeTypes": [
              "text/plain",
              "image/*"
            ],
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59d2a8c8-fe8f-4e59-874f-a5887f584a20"
      }
    },
    "owner": "tianma-if-edgeever"
  }
}
