---
import Container from "@/components/container.astro";
import Features from "@/components/features.astro";
import Guides from "@/components/guides.astro";
import Hero from "@/components/hero.astro";
import Logos from "@/components/logos.astro";
import MarqueeShowcase from "@/components/marquee-showcase.astro";
import Layout from "@/layouts/Layout.astro";

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "EdgeEver",
    url: siteUrl,
    inLanguage: "zh-CN",
    description:
      "EdgeEver 是支持跨端同步、网页剪藏与 Markdown 导出的开源自托管笔记软件。",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "EdgeEver",
    url: siteUrl,
    codeRepository: "https://github.com/tianma-if/edgeever",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS, Windows, Linux, iOS, Android, Web, Chrome, Edge, Firefox",
    isAccessibleForFree: true,
    description:
      "EdgeEver 支持在 Cloudflare 或 Docker 上自托管，通过同一个实例同步桌面端和手机端。提供三栏笔记本、网页剪藏、Markdown 导出与 MCP 接入。",
  },
];
---

<Layout title="" jsonLd={homeJsonLd} localeRedirect={false}>
  <Container>
    <Hero />
    <MarqueeShowcase />
    <Features />
    <Guides />
    <Logos />
  </Container>
</Layout>
