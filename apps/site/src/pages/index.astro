---
import Container from "@/components/container.astro";
import Features from "@/components/features.astro";
import Guides from "@/components/guides.astro";
import Hero from "@/components/hero.astro";
import Logos from "@/components/logos.astro";
import MarqueeShowcase from "@/components/marquee-showcase.astro";
import Layout from "@/layouts/Layout.astro";

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "EdgeEver",
    url: siteUrl,
    inLanguage: "zh-CN",
    description:
      "EdgeEver 是开源、原生支持 AI 的自托管笔记工作区，支持 Cloudflare 与 Docker 自由部署，覆盖 macOS、Windows 预览版、iOS、Android 与浏览器插件。",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "EdgeEver",
    url: siteUrl,
    codeRepository: "https://github.com/tianma-if/edgeever",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS, Windows, iOS, Android, Web, Chrome, Edge, Firefox",
    isAccessibleForFree: true,
    description:
      "EdgeEver 是开源、原生支持 AI 的自托管笔记工作区，保留经典印象笔记三栏体验，覆盖 macOS、Windows 预览版、iOS、Android 与浏览器插件，并提供 REST API、OpenAPI schema 和 MCP endpoint。",
  },
];
---

<Layout title="" jsonLd={homeJsonLd}>
  <Container>
    <Hero />
    <MarqueeShowcase />
    <Features />
    <Guides />
    <Logos />
  </Container>
</Layout>
