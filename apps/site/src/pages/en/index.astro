---
import Container from "@/components/container.astro";
import Features from "@/components/features.astro";
import Guides from "@/components/guides.astro";
import Hero from "@/components/hero.astro";
import Logos from "@/components/logos.astro";
import MarqueeShowcase from "@/components/marquee-showcase.astro";
import Layout from "@/layouts/Layout.astro";

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "EdgeEver",
    alternateName: "EdgeEver Evernote Alternative",
    url: siteUrl,
    inLanguage: "en-US",
    description:
      "EdgeEver is an open-source, AI-native, self-hosted Evernote alternative across macOS, Windows, iOS, Android, and Web Clipper with Cloudflare & Docker deployment.",
    keywords: ["Evernote alternative", "open-source notes app", "self-hosted notes app", "AI notes app"],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "EdgeEver",
    alternateName: "EdgeEver Evernote Alternative",
    url: siteUrl,
    codeRepository: "https://github.com/tianma-if/edgeever",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS, Windows, iOS, Android, Web, Chrome, Edge, Firefox",
    isAccessibleForFree: true,
    description:
      "EdgeEver is an open-source, AI-native, self-hosted Evernote alternative with a classic three-pane workflow, apps across macOS, Windows, iOS, Android and browsers, plus a REST API, OpenAPI schema, and MCP endpoint.",
    keywords: ["Evernote alternative", "open-source notes app", "self-hosted notes app", "AI notes app"],
  },
];
---

<Layout title="" jsonLd={homeJsonLd}>
  <Container>
    <Hero />
    <MarqueeShowcase />
    <Features />
    <Guides />
    <Logos />
  </Container>
</Layout>
