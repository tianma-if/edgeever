---
import Container from "@/components/container.astro";
import Features from "@/components/features.astro";
import Guides from "@/components/guides.astro";
import Hero from "@/components/hero.astro";
import Logos from "@/components/logos.astro";
import MarqueeShowcase from "@/components/marquee-showcase.astro";
import Layout from "@/layouts/Layout.astro";

const siteUrl = new URL(Astro.url.pathname, Astro.site).toString();

const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "EdgeEver",
    url: siteUrl,
    inLanguage: "en-US",
    description:
      "EdgeEver is an open-source notes app with self-hosted sync across desktop and mobile.",
    keywords: ["Evernote alternative", "open-source notes app", "self-hosted notes app", "AI notes app"],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "EdgeEver",
    url: siteUrl,
    codeRepository: "https://github.com/tianma-if/edgeever",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "macOS, Windows, Linux, iOS, Android, Web, Chrome, Edge, Firefox",
    isAccessibleForFree: true,
    description:
      "Deploy EdgeEver on Cloudflare or with Docker to sync desktop and mobile clients. It includes three-pane notebooks, a web clipper, Markdown export, and a built-in MCP interface.",
    keywords: ["Evernote alternative", "open-source notes app", "self-hosted notes app", "AI notes app"],
  },
];
---

<Layout title="" jsonLd={homeJsonLd}>
  <Container>
    <Hero />
    <MarqueeShowcase />
    <Features />
    <Guides />
    <Logos />
  </Container>
</Layout>
