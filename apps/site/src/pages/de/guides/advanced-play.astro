---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";

const title = "Fortgeschrittene KI-Agenten-Workflows in EdgeEver";
const description = "Verwenden Sie EdgeEver MCP, um anhand echter Notizen ein Personenprofil, eine Wissenslandkarte und ein klareres Tag-System zu erstellen.";

const prompts = [
  {
    title: "Personenprofil",
    summary: "Aus Notizen langfristige Schwerpunkte, Arbeitsweisen, Stärkenmuster, wiederkehrende Hürden und aktuelle Entwicklungen ableiten.",
    prompt: "Use EdgeEver MCP to read my notes and create a persona profile based on the real note content. Judge only from evidence in the notes, do not make psychological diagnoses, and do not exaggerate traits. Include long-term themes, work preferences, capability signals, recurring problems, recent direction, and list related note titles or memo ids after each conclusion.",
  },
  {
    title: "Wissenslandkarte",
    summary: "Notizen in Wissensbereiche, Kernkonzepte, Begleitmaterialien, gefestigtes Wissen und bestehende Lücken strukturieren.",
    prompt: "Use EdgeEver MCP to read my notes and organize a knowledge map. Identify the main knowledge areas, key concepts in each area, related notes, what I already understand, and the gaps I still need to fill. Structure the output so it is useful for continued learning and writing.",
  },
  {
    title: "Tag-Vorschläge",
    summary: "Vorhandene Tags analysieren, um Duplikate, zu enge Begriffe oder uneinheitliche Benennungen vor Anpassungen aufzudecken.",
    prompt: "Use EdgeEver MCP to read my notes and existing tags, then design a clearer tag system. Point out duplicate, overly narrow, overly broad, or inconsistently named tags, and suggest merges, renames, and new tags. Do not modify notes yet. Wait for my confirmation before applying changes.",
  },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: pageUrl,
  inLanguage: "de",
  publisher: {
    "@type": "Organization",
    name: "EdgeEver",
  },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Container>
    <main class="mx-auto max-w-4xl py-16 md:py-24">
      <p class="text-sm font-semibold text-brand-text">AI Agent Workflow</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">{description}</p>
      <p class="mt-3 text-sm text-slate-500">Die Prompts sind auf Englisch formuliert, damit Sie diese unverändert an Ihren KI-Agenten übergeben können.</p>

      <div class="mt-12 space-y-8">
        {
          prompts.map((item, index) => (
            <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm md:p-8">
              <div class="flex items-center gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand/10 text-sm font-bold text-brand">
                  0{index + 1}
                </span>
                <h2 class="text-xl font-bold text-slate-900">{item.title}</h2>
              </div>
              <p class="mt-3 text-base leading-7 text-slate-600">{item.summary}</p>
              <div class="relative mt-4">
                <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-sm leading-6 text-slate-200 whitespace-pre-wrap"><code>{item.prompt}</code></pre>
                <button
                  data-copy-prompt
                  data-prompt-text={item.prompt}
                  class="absolute right-3 top-3 rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-300 transition hover:bg-slate-700 hover:text-white"
                >
                  Copy
                </button>
              </div>
            </section>
          ))
        }
      </div>
    </main>
  </Container>
</Layout>

<script>
  function setupCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.getAttribute("data-prompt-text") || "";
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = "Copied!";
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch {
          // Fallback or ignore
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener("astro:page-load", setupCopyButtons);
</script>
