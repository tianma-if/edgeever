---
import { getHeroImage } from "@/assets/hero";
import { Icon } from "astro-icon/components";
import { Meteors } from "@/components/magicui/meteors";
import { getLocalizedPath, getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const heroProductImage = getHeroImage(locale);
const copy = siteCopy[locale].hero;
const firefoxClipperHref =
  locale === "zh-CN"
    ? "https://addons.mozilla.org/zh-CN/firefox/addon/edgeever-web-clipper/"
    : "https://addons.mozilla.org/firefox/addon/edgeever-web-clipper/";
const iosRegionNotice =
  locale === "zh-CN"
    ? "注：iOS 客户端需使用非中国大陆区 Apple ID 从 App Store 下载。"
    : locale === "zh-TW"
      ? "註：iOS 用戶端需使用非中國大陸區 Apple ID 從 App Store 下載。"
      : null;
const focusRingClass =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40 focus-visible:ring-offset-2";
---

<main class="relative flex flex-col items-center pt-1 pb-8 md:pt-2 md:pb-12 overflow-hidden max-w-full">
  <!-- Unified Ambient Stage Aura -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[560px] sm:w-[920px] h-[440px] sm:h-[560px] bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.09),transparent_68%)] rounded-full blur-2xl"></div>
    <div class="absolute top-12 left-1/4 w-[280px] sm:w-[450px] h-[280px] sm:h-[450px] bg-emerald-500/[0.04] rounded-full blur-3xl animate-slow-spin"></div>
    <div class="absolute bottom-8 right-1/4 w-[240px] sm:w-[380px] h-[240px] sm:h-[380px] bg-emerald-500/[0.04] rounded-full blur-3xl animate-float"></div>
    <Meteors number={12} client:load />
  </div>

  <!-- 1. Compact Unified Header Band (Left Title & Slogan + Right Primary CTAs) -->
  <div class="animate-rise relative z-20 w-full flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 lg:gap-6 min-w-0" style="animation-delay: 0ms;">
    <div class="flex flex-col items-center lg:items-start text-center lg:text-left min-w-0 lg:max-w-2xl">
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 max-w-full">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-none tracking-tight shrink-0">
          <span class="text-gradient">EdgeEver</span>
        </h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-50/90 border border-emerald-200/80 text-emerald-800 text-xs font-semibold leading-snug text-balance">
          {copy.popHighlight}
        </span>
      </div>
      <p class="hero-slogan text-balance mt-1.5 text-sm sm:text-[15px] font-normal leading-relaxed text-slate-600 max-w-2xl">
        {copy.slogan}
      </p>
    </div>

    <!-- Primary Action Buttons -->
    <div class="flex flex-col sm:flex-row sm:flex-wrap lg:flex-nowrap items-stretch sm:items-center justify-center lg:justify-end gap-2.5 shrink-0 max-w-full z-20">
      <a
        href="https://demo.edgeever.org"
        target="_blank"
        class={`group inline-flex h-11 sm:h-10 gap-2 items-center justify-center px-5 text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm hover:shadow-[0_8px_20px_-6px_rgba(5,150,105,0.4)] transition-all duration-300 hover:-translate-y-0.5 rounded-full font-semibold text-sm whitespace-nowrap ${focusRingClass}`}
        rel="noopener noreferrer">
        <Icon class="w-4 h-4 shrink-0 transition-transform duration-200 group-hover:scale-110" name="bx:bx-show" aria-hidden="true" />
        <span>{copy.demo}</span>
      </a>
      <a
        href="https://github.com/tianma-if/edgeever"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="EdgeEver on GitHub"
        class={`group inline-flex h-11 sm:h-10 gap-2 items-center justify-center px-4 border border-slate-200 hover:border-slate-300 bg-white/90 hover:bg-slate-50/90 backdrop-blur-sm text-slate-800 transition-all duration-300 rounded-full font-semibold text-sm hover:-translate-y-0.5 shadow-2xs hover:shadow-xs whitespace-nowrap ${focusRingClass}`}
      >
        <Icon class="text-slate-800 w-4 h-4 shrink-0 transition-transform duration-200 group-hover:scale-110" name="bx:bxl-github" aria-hidden="true" />
        <span>GitHub</span>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 group-hover:text-slate-700 transition-colors tabular-nums ml-0.5">
          <Icon name="bx:bxs-star" class="w-3.5 h-3.5 text-amber-500" aria-hidden="true" />
          <span data-github-stars>--</span>
        </span>
      </a>
      <a
        href={getLocalizedPath(locale, "/blog/ai-agent-deploy-cloudflare")}
        class={`inline-flex h-11 sm:h-10 gap-2 items-center justify-center px-4 bg-white/90 border border-slate-200 hover:border-slate-300 hover:bg-slate-50/90 text-slate-700 hover:text-slate-900 transition-all duration-300 rounded-full font-semibold text-sm hover:-translate-y-0.5 shadow-2xs hover:shadow-xs whitespace-nowrap ${focusRingClass}`}
      >
        <Icon class="w-4 h-4 shrink-0 text-slate-500" name="simple-icons:cloudflare" aria-hidden="true" />
        <span>{copy.agentInstall}</span>
      </a>
    </div>
  </div>

  <!-- 2. Full-Sight Uncompressed 4K Product Showcase -->
  <div class="mt-2 sm:mt-3 w-full max-w-full relative z-10 flex justify-center">
    <div class="relative w-full max-w-full pointer-events-none select-none flex justify-center">
      <img
        src={heroProductImage.src}
        width={heroProductImage.width}
        height={heroProductImage.height}
        alt={copy.imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="block w-auto max-w-full lg:max-h-[calc(100svh-11rem)] h-auto object-contain pointer-events-none select-none"
      />
    </div>
  </div>

  <!-- 3. Multi-Platform Client Badges & Migration Dock -->
  <div class="animate-rise mt-1 sm:mt-2 w-full max-w-5xl z-30 relative text-center" style="animation-delay: 180ms;">
    <div class="pt-4 border-t border-slate-200/70 flex flex-wrap items-center justify-center gap-2">
        <span class="text-[11px] font-semibold text-slate-500 mr-1 select-none">
          {copy.getApps}
        </span>
        <a
          href="https://github.com/tianma-if/edgeever/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="bx:bxl-apple" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>macOS</span>
        </a>
        <a
          href="https://github.com/tianma-if/edgeever/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="bx:bxl-windows" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>{copy.windows}</span>
        </a>
        <a
          href="https://github.com/tianma-if/edgeever/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="simple-icons:linux" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>{copy.linux}</span>
        </a>
        <a
          href={
            locale === "ja"
              ? "https://apps.apple.com/jp/app/edgeever/id6792625631"
              : locale === "pl"
                ? "https://apps.apple.com/pl/app/edgeever/id6792625631"
                : locale === "es"
                  ? "https://apps.apple.com/es/app/edgeever/id6792625631"
                  : locale === "de"
                    ? "https://apps.apple.com/de/app/edgeever/id6792625631"
                    : locale === "fr"
                      ? "https://apps.apple.com/fr/app/edgeever/id6792625631"
                      : locale === "ru"
                        ? "https://apps.apple.com/ru/app/edgeever/id6792625631"
                        : locale === "zh-TW"
                          ? "https://apps.apple.com/tw/app/edgeever/id6792625631"
                          : "https://apps.apple.com/us/app/edgeever/id6792625631"
          }
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="bx:bx-mobile" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>iOS</span>
        </a>
        <a
          href={
            locale === "zh-CN"
              ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=zh-CN"
              : locale === "zh-TW"
                ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=zh-TW"
                : locale === "ja"
                  ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=ja"
                  : locale === "pl"
                    ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=pl"
                    : locale === "es"
                      ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=es"
                      : locale === "de"
                        ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=de"
                        : locale === "fr"
                          ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=fr"
                          : locale === "ru"
                            ? "https://play.google.com/store/apps/details?id=org.edgeever.mobile&hl=ru"
                            : "https://play.google.com/store/apps/details?id=org.edgeever.mobile"
          }
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="bx:bxl-android" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>Android</span>
        </a>
        <a
          href="https://chromewebstore.google.com/detail/edgeever-web-clipper/gjadpfmanienmlofajibkfkkpfdkclgo"
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="simple-icons:googlechrome" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>Chrome / Edge · {copy.clipper}</span>
        </a>
        <a
          href={firefoxClipperHref}
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex min-h-11 sm:min-h-0 items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/80 hover:bg-slate-100/90 hover:text-slate-900 hover:border-slate-300 border border-slate-200/80 text-[11px] font-medium text-slate-600 transition-all shadow-2xs ${focusRingClass}`}
        >
          <Icon name="simple-icons:firefox" class="w-3.5 h-3.5 text-slate-700" aria-hidden="true" />
          <span>Firefox · {copy.clipper}</span>
        </a>
      </div>

      {iosRegionNotice && (
        <p class="mt-2 text-[11px] text-slate-500">
          {iosRegionNotice}
        </p>
      )}

      <!-- Third-Party Note Migration Entry -->
      <div class="mt-3.5 flex flex-wrap items-center justify-center">
        <a
          href={getLocalizedPath(locale, "/blog/note-migration-guide")}
          class={`group/mig inline-flex max-w-full items-center gap-2 px-3 py-1.5 rounded-lg bg-white/80 hover:bg-slate-50 border border-slate-200/80 hover:border-slate-300 text-xs text-slate-700 transition-all duration-200 shadow-2xs hover:shadow-xs ${focusRingClass}`}
        >
          <span class="flex items-center gap-1.5 font-semibold text-slate-800 shrink-0">
            <Icon name="bx:bx-transfer-alt" class="w-4 h-4 text-emerald-600 group-hover/mig:scale-110 transition-transform" aria-hidden="true" />
            <span>{copy.migrationTitle}</span>
          </span>
          <span class="text-slate-300 select-none hidden sm:inline" aria-hidden="true">·</span>
          <span class="text-slate-500 text-[11px] sm:text-xs truncate min-w-0">{copy.migrationSubtitle}</span>
          <Icon name="bx:bx-right-arrow-alt" class="w-3.5 h-3.5 text-slate-400 group-hover/mig:text-slate-700 group-hover/mig:translate-x-0.5 transition-transform shrink-0 ml-auto sm:ml-0" aria-hidden="true" />
        </a>
      </div>
  </div>
</main>

<style>
  .hero-slogan {
    font-family:
      "Inter Variable",
      Inter,
      "Hiragino Sans",
      "Hiragino Kaku Gothic ProN",
      "Yu Gothic",
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      ui-sans-serif,
      system-ui,
      sans-serif;
  }
</style>

<script is:inline>
  (function () {
    function formatCount(count) {
      if (typeof count !== "number") return String(count);
      try {
        return new Intl.NumberFormat("en", {
          notation: "compact",
          maximumFractionDigits: 1,
        }).format(count).toLowerCase();
      } catch (e) {
        if (count >= 1000) {
          return (Math.round(count / 100) / 10).toFixed(1).replace(/\.0$/, "") + "k";
        }
        return count.toLocaleString();
      }
    }

    async function fetchGitHubStats() {
      var starEls = document.querySelectorAll("[data-github-stars]");
      var forkEls = document.querySelectorAll("[data-github-forks]");
      if (!starEls.length && !forkEls.length) return;

      // 1. Direct real-time fetch from GitHub API (always fresh, no cache)
      try {
        var res = await fetch("https://api.github.com/repos/tianma-if/edgeever", {
          headers: { Accept: "application/vnd.github.v3+json" },
          cache: "no-store",
        });
        if (res.ok) {
          var data = await res.json();
          if (typeof data.stargazers_count === "number") {
            starEls.forEach(function (el) { el.textContent = formatCount(data.stargazers_count); });
          }
          if (typeof data.forks_count === "number") {
            forkEls.forEach(function (el) { el.textContent = formatCount(data.forks_count); });
          }
          return;
        }
      } catch (e) {
        // Fall back to Shields live JSON endpoint if GitHub API is unavailable/rate-limited
      }

      // 2. Fallback: Shields.io live JSON API (same data source as Readme badges)
      try {
        var responses = await Promise.all([
          fetch("https://img.shields.io/github/stars/tianma-if/edgeever.json", { cache: "no-store" }),
          fetch("https://img.shields.io/github/forks/tianma-if/edgeever.json", { cache: "no-store" }),
        ]);
        if (responses[0].ok) {
          var sData = await responses[0].json();
          var sVal = sData.value || sData.message;
          if (sVal) starEls.forEach(function (el) { el.textContent = sVal; });
        }
        if (responses[1].ok) {
          var fData = await responses[1].json();
          var fVal = fData.value || fData.message;
          if (fVal) forkEls.forEach(function (el) { el.textContent = fVal; });
        }
      } catch (e) {
        // Ignore fallback errors
      }
    }

    fetchGitHubStats();
    document.addEventListener("astro:page-load", fetchGitHubStats);
  })();
</script>
