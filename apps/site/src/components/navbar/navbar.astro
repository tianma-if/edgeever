---
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import LanguageSwitcher from "./language-switcher.astro";
import { Icon } from "astro-icon/components";
import { getLocalizedPath, getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].nav;
const focusRingClass =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40 focus-visible:ring-offset-2";
const menuitems = [
  {
    title: copy.features,
    path: `${getLocalizedPath(locale, "/")}#features`,
  },
  {
    title: copy.bestPractices,
    path: getLocalizedPath(locale, "/guides/best-practices"),
  },
  {
    title: copy.deploy,
    children: [
      {
        title: copy.cloudflareDeploy,
        path: getLocalizedPath(locale, "/blog/ai-agent-deploy-cloudflare"),
      },
      {
        title: copy.dockerDeploy,
        path: getLocalizedPath(locale, "/docker-deploy"),
      },
    ],
  },
  {
    title: copy.blog,
    path: getLocalizedPath(locale, "/blog"),
  },
];
---

<Container>
  <header class="relative my-3 md:my-3.5 z-50">
    <div class="flex items-center justify-between gap-2">
      <!-- Logo Left -->
      <a href={getLocalizedPath(locale, "/")} class={`flex items-center gap-2 text-lg select-none rounded-lg ${focusRingClass}`} aria-label={copy.homeAria}>
        <img src="/favicon.svg" alt="" class="h-8 w-8 shrink-0" aria-hidden="true" />
        <span>
          <span class="font-bold text-slate-800 tracking-tight text-base md:text-lg">Edge</span><span class="text-slate-500 text-base md:text-lg">Ever</span>
        </span>
      </a>

      <!-- Desktop Navigation Center -->
      <nav class="hidden lg:flex items-center gap-1" aria-label={copy.homeAria}>
        <ul class="flex items-center gap-1">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class={`px-3.5 py-2 text-[13.5px] font-semibold text-slate-600 hover:text-emerald-700 hover:bg-slate-100/70 rounded-full transition-colors whitespace-nowrap ${focusRingClass}`}>
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </nav>

      <!-- Actions & Hamburger Right -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <a
          href="https://www.producthunt.com/products/edgeever?launch=edgeever&utm_source=badge-featured&utm_medium=badge&utm_campaign=edgeever"
          target="_blank"
          rel="noopener noreferrer"
          class={`hidden sm:inline-flex items-center overflow-hidden transition-transform duration-200 hover:-translate-y-0.5 shrink-0 rounded-md ${focusRingClass}`}
        >
          <img
            src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=edgeever&theme=neutral"
            alt="EdgeEver on Product Hunt"
            style="width: 120px; height: 26px;"
            width="120"
            height="26"
            decoding="async"
            onerror="this.parentElement.style.display='none'"
          />
        </a>

        <!-- Desktop Only Items -->
        <div class="hidden lg:flex items-center gap-2.5">
          <LanguageSwitcher pathname={Astro.url.pathname} />
          <a
            href="https://github.com/tianma-if/edgeever"
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200/90 hover:border-slate-300 rounded-full transition-all duration-200 shadow-2xs whitespace-nowrap ${focusRingClass}`}
            aria-label="GitHub"
          >
            <Icon class="h-4 w-4 text-slate-800" name="bx:bxl-github" aria-hidden="true" />
            <span>{copy.openSource}</span>
          </a>
        </div>

        <!-- Mobile Hamburger Toggle Button -->
        <button
          type="button"
          id="mobile-nav-toggle"
          aria-label="Toggle mobile menu"
          aria-controls="mobile-nav-menu"
          aria-expanded="false"
          class={`lg:hidden min-h-11 min-w-11 p-2 rounded-xl border border-slate-200/80 bg-white/90 text-slate-700 hover:bg-slate-100 transition-colors ${focusRingClass}`}
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div
      id="mobile-nav-menu"
      class="hidden lg:hidden mt-3 rounded-2xl border border-slate-200/90 bg-white/95 backdrop-blur-lg p-4 shadow-xl flex flex-col gap-3 transition-all"
    >
      <ul class="flex flex-col gap-1.5">
        {
          menuitems.map((item) => (
            <>
              {item.children ? (
                <li class="py-1">
                  <div class="px-3 py-1 text-xs font-bold text-slate-400 uppercase tracking-wider">{item.title}</div>
                  <div class="mt-1 flex flex-col gap-1 pl-2">
                    {item.children.map((child) => (
                      <a
                        href={child.path}
                        class={`flex min-h-11 items-center px-3 py-2 text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/70 rounded-xl transition-colors ${focusRingClass}`}
                      >
                        {child.title}
                      </a>
                    ))}
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={item.path}
                    class={`flex min-h-11 items-center px-3 py-2 text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/70 rounded-xl transition-colors ${focusRingClass}`}
                  >
                    {item.title}
                  </a>
                </li>
              )}
            </>
          ))
        }
      </ul>

      <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex-1 min-w-[140px]">
          <LanguageSwitcher pathname={Astro.url.pathname} compact />
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="https://demo.edgeever.org"
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex min-h-11 items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shrink-0 whitespace-nowrap ${focusRingClass}`}
          >
            <Icon class="h-3.5 w-3.5 shrink-0" name="bx:bx-show" aria-hidden="true" />
            <span>{copy.demo}</span>
          </a>
          <a
            href="https://github.com/tianma-if/edgeever"
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex min-h-11 items-center gap-1.5 px-3 py-2 text-xs font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg shrink-0 whitespace-nowrap ${focusRingClass}`}
            aria-label="GitHub"
          >
            <Icon class="h-4 w-4 text-slate-800 shrink-0" name="bx:bxl-github" aria-hidden="true" />
            <span class="whitespace-nowrap shrink-0">{copy.openSource}</span>
          </a>
        </div>
      </div>

      <div class="sm:hidden pt-1 flex justify-center">
        <a
          href="https://www.producthunt.com/products/edgeever?launch=edgeever&utm_source=badge-featured&utm_medium=badge&utm_campaign=edgeever"
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex items-center overflow-hidden rounded-md ${focusRingClass}`}
        >
          <img
            src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=edgeever&theme=neutral"
            alt="EdgeEver on Product Hunt"
            style="width: 120px; height: 26px;"
            width="120"
            height="26"
            loading="lazy"
            decoding="async"
            onerror="this.parentElement.style.display='none'"
          />
        </a>
      </div>
    </div>
  </header>
</Container>

<script is:inline>
  (function () {
    if (window.__edgeeverNavInitialized) return;
    window.__edgeeverNavInitialized = true;

    function setMenuOpen(isOpen) {
      var toggleBtn = document.getElementById("mobile-nav-toggle");
      var menu = document.getElementById("mobile-nav-menu");
      var hamburgerIcon = document.getElementById("hamburger-icon");
      var closeIcon = document.getElementById("close-icon");
      if (!menu || !toggleBtn) return;
      menu.classList.toggle("hidden", !isOpen);
      toggleBtn.setAttribute("aria-expanded", String(isOpen));
      if (hamburgerIcon) hamburgerIcon.classList.toggle("hidden", isOpen);
      if (closeIcon) closeIcon.classList.toggle("hidden", !isOpen);
    }

    document.addEventListener("click", function (e) {
      var toggleBtn = e.target && e.target.closest ? e.target.closest("#mobile-nav-toggle") : null;
      var menu = document.getElementById("mobile-nav-menu");

      if (toggleBtn && menu) {
        e.preventDefault();
        e.stopPropagation();
        var isHidden = menu.classList.contains("hidden");
        setMenuOpen(isHidden);
      } else if (menu && !menu.classList.contains("hidden")) {
        var clickedNavLink = e.target && e.target.closest ? e.target.closest("#mobile-nav-menu a") : null;
        if (clickedNavLink) {
          setMenuOpen(false);
        }
      }

      // Close all open <details> menus when clicking outside
      document.querySelectorAll("header details[open]").forEach(function (details) {
        if (!details.contains(e.target)) {
          details.removeAttribute("open");
        }
      });
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;

      var openDetails = document.querySelector("header details[open]");
      if (openDetails) {
        openDetails.removeAttribute("open");
        openDetails.querySelector("summary")?.focus();
        return;
      }

      var toggleBtn = document.getElementById("mobile-nav-toggle");
      var menu = document.getElementById("mobile-nav-menu");
      if (!toggleBtn || !menu || menu.classList.contains("hidden")) return;

      setMenuOpen(false);
      toggleBtn.focus();
    });
  })();
</script>
