---
import { getLocalizedPath, getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].guides;
---

<section class="mt-12 md:mt-24 px-4" aria-labelledby="guides">
  <div class="max-w-3xl">
    <span class="inline-block px-3 py-1 text-xs font-bold tracking-widest text-emerald-600 bg-emerald-50 rounded-full border border-emerald-200/60 uppercase">
      {copy.eyebrow}
    </span>
    <h2 id="guides" class="mt-3 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900">
      {copy.heading}
    </h2>
    <p class="mt-3 sm:mt-4 text-xs sm:text-sm md:text-base leading-relaxed text-slate-600">
      {copy.description}
    </p>
  </div>

  <div class="mt-6 md:mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
    {
      copy.items.map((item) => (
        <a
          href={getLocalizedPath(locale, item.href)}
          class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs transition hover:-translate-y-0.5 hover:border-emerald-500/40 hover:shadow-lg"
        >
          <div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 transition group-hover:text-emerald-700">{item.title}</h3>
            <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-600">{item.summary}</p>
          </div>
          <span class="mt-5 text-xs sm:text-sm font-semibold text-emerald-700 flex items-center gap-1">
            <span>{item.cta}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>
