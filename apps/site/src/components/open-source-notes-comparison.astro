---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { notesComparisonCopy, notesComparisonLocales } from "@/data/open-source-notes-comparison";
import { getLocalizedPath } from "@/i18n";

interface Props {
  locale: (typeof notesComparisonLocales)[number];
}

const { locale } = Astro.props;
const copy = notesComparisonCopy[locale];
const sampleArticle = "https://developer.mozilla.org/zh-CN/docs/Learn_web_development/Getting_started/Web_standards/How_the_web_works";
const linkClass = "font-semibold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:text-emerald-900";
---

<Layout title={copy.title} description={copy.description} alternateLocales={notesComparisonLocales} localeRedirect={false}>
  <Container>
    <main class="mx-auto max-w-5xl px-4 py-14 md:py-20">
      <h1 class="max-w-4xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">{copy.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700">{copy.intro}</p>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">{copy.disclosure}</p>

      <section class="mt-10" aria-labelledby="comparison">
        <h2 id="comparison" class="text-2xl font-bold text-slate-900">{copy.comparison}</h2>
        <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full min-w-[46rem] text-left text-sm leading-6 text-slate-700" aria-labelledby="comparison">
            <thead class="bg-slate-50 text-slate-900">
              <tr>
                {copy.headers.map((header) => <th scope="col" class="px-4 py-3 font-semibold">{header}</th>)}
              </tr>
            </thead>
            <tbody>
              {copy.products.map((product) => (
                <tr class="border-t border-slate-200 align-top">
                  <th scope="row" class="w-36 px-4 py-4 font-semibold text-slate-900">
                    <span class="block">{product.name}</span>
                    {product.sources.map((source) => (
                      <a href={source.href} class={`mt-1 block text-xs ${linkClass}`} aria-label={`${product.name} · ${source.label}`}>
                        {source.label}
                      </a>
                    ))}
                  </th>
                  {product.cells.map((cell) => <td class="px-4 py-4">{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10 max-w-3xl" aria-labelledby="checks">
        <h2 id="checks" class="text-2xl font-bold text-slate-900">{copy.testTitle}</h2>
        <ol class="mt-4 list-decimal space-y-3 pl-5 leading-7 text-slate-700">
          {copy.checks.map((check) => <li class="pl-1">{check}</li>)}
        </ol>
        <p class="mt-4"><a href={sampleArticle} class={linkClass}>{copy.sampleLabel}</a></p>
      </section>

      <section class="mt-10 max-w-3xl" aria-labelledby="choose">
        <h2 id="choose" class="text-2xl font-bold text-slate-900">{copy.fitTitle}</h2>
        <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-slate-700">
          {copy.choices.map((choice) => <li>{choice}</li>)}
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="https://demo.edgeever.org/" class={linkClass}>{copy.demo}</a>
          <a href={getLocalizedPath(locale, "/blog/ai-agent-deploy-cloudflare/")} class={linkClass}>{copy.docs}</a>
          <a href={getLocalizedPath(locale, "/self-hosted-evernote-alternative/")} class={linkClass}>{copy.migration}</a>
        </div>
      </section>
    </main>
  </Container>
</Layout>
