---
import { Icon } from "astro-icon/components";
import { getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].marquee;

// Duplicate list for seamless infinite loop (Track 1 + Track 2)
const doubleItems = [...copy.items, ...copy.items];
---

<section id="platforms" class="mt-12 md:mt-24 w-full overflow-hidden py-8 md:py-10 bg-slate-50/60 border-y border-slate-200/60 scroll-mt-6">
  <div class="max-w-4xl mx-auto text-center px-4 mb-6 md:mb-8">
    <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
      {copy.title}
    </h2>
    <p class="text-slate-500 text-xs sm:text-sm mt-1.5 md:mt-2 leading-relaxed">
      {copy.subtitle}
    </p>
  </div>

  <!-- Marquee Container with Side Gradient Fades -->
  <div class="group relative mt-4 md:mt-6 w-full">
    <div class="flex w-max gap-3 sm:gap-4 animate-site-marquee group-hover:[animation-play-state:paused]">
      {doubleItems.map((item, index) => (
        <div aria-hidden={index >= copy.items.length ? "true" : undefined} class={`relative w-64 sm:w-72 shrink-0 rounded-2xl border border-slate-200/80 bg-gradient-to-br ${item.color} p-4 sm:p-5 shadow-xs transition-all duration-300 hover:shadow-md hover:border-emerald-400 bg-white`}>
          <div class="flex items-center justify-between mb-2.5 sm:mb-3">
            <span class="px-2 py-0.5 text-[9.5px] sm:text-[10px] font-bold text-emerald-700 bg-emerald-100/80 rounded-md">
              {item.tag}
            </span>
            <Icon name={item.icon} class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-600" />
          </div>
          <h4 class="font-bold text-slate-900 text-xs sm:text-sm">{item.title}</h4>
          <p class="text-slate-500 text-[10.5px] sm:text-[11.5px] mt-1 leading-snug">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Side Gradient Fade Masks -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-12 sm:w-28 bg-gradient-to-r from-slate-50 via-slate-50/80 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-12 sm:w-28 bg-gradient-to-l from-slate-50 via-slate-50/80 to-transparent z-10"></div>
  </div>
</section>

<style>
  .animate-site-marquee {
    animation: site-marquee 35s linear infinite;
  }

  @keyframes site-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-site-marquee {
      animation: none;
    }
  }
</style>
