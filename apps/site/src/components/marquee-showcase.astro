---
import { Icon } from "astro-icon/components";
import { getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].marquee;

// Duplicate list for seamless infinite loop (Track 1 + Track 2)
const doubleItems = [...copy.items, ...copy.items];
---

<section class="mt-16 md:mt-24 w-full overflow-hidden py-10 bg-slate-50/60 border-y border-slate-200/60">
  <div class="max-w-4xl mx-auto text-center px-4 mb-8">
    <h3 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
      {copy.title}
    </h3>
    <p class="text-slate-500 text-sm mt-2">
      {copy.subtitle}
    </p>
  </div>

  <!-- Marquee Container with Side Gradient Fades -->
  <div class="group relative mt-6 w-full">
    <div class="flex w-max gap-4 animate-site-marquee group-hover:[animation-play-state:paused]">
      {doubleItems.map((item) => (
        <div class={`relative w-72 shrink-0 rounded-2xl border border-slate-200/80 bg-gradient-to-br ${item.color} p-5 shadow-xs transition-all duration-300 hover:shadow-md hover:border-emerald-400 bg-white`}>
          <div class="flex items-center justify-between mb-3">
            <span class="px-2 py-0.5 text-[10px] font-bold text-emerald-700 bg-emerald-100/80 rounded-md">
              {item.tag}
            </span>
            <Icon name={item.icon} class="w-5 h-5 text-emerald-600" />
          </div>
          <h4 class="font-bold text-slate-900 text-sm">{item.title}</h4>
          <p class="text-slate-500 text-[11.5px] mt-1 leading-snug">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Side Gradient Fade Masks (Pireel Style) -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-slate-50 via-slate-50/80 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-28 bg-gradient-to-l from-slate-50 via-slate-50/80 to-transparent z-10"></div>
  </div>
</section>

<style>
  .animate-site-marquee {
    animation: site-marquee 35s linear infinite;
  }

  @keyframes site-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-site-marquee {
      animation: none;
    }
  }
</style>
