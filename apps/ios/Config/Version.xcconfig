// Bump MARKETING_VERSION with monorepo release X.Y.Z when shipping App Store builds.
// CURRENT_PROJECT_VERSION must increase for every store upload (TestFlight / App Store).
// Build 30+ marks the native SwiftUI client (RN EAS builds ended at 29).
//
// Xcode Cloud overwrites CFBundleVersion with its managed "next build number"
// (App Store Connect → Xcode Cloud → Settings → Build Number). Keep that value
// ≥ this file and ≥ the latest ASC build. ci_pre_xcodebuild.sh also stamps
// CI_BUILD_NUMBER into the archive when present.
// Last completed ASC store build: 38 (2026-08-23, Xcode Cloud). The next Cloud run must be 39+.
MARKETING_VERSION = 1.39.0
CURRENT_PROJECT_VERSION = 39
