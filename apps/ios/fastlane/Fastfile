opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Submit an uploaded App Store Connect build to App Review and release it automatically after approval"
  lane :submit_review do
    version = ENV.fetch("APP_STORE_VERSION")
    build_number = ENV.fetch("APP_STORE_BUILD_NUMBER")
    release_notes = {
      "zh-Hans" => ENV.fetch("APP_STORE_RELEASE_NOTES_ZH"),
      "en-US" => ENV.fetch("APP_STORE_RELEASE_NOTES_EN")
    }

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "org.edgeever.mobile",
      app_version: version,
      build_number: build_number,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      release_notes: release_notes,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end
