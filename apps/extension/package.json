{
  "name": "@edgeever/extension",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "build:firefox": "EDGE_EVER_EXTENSION_TARGET=firefox vite build --config vite.config.ts",
    "dev": "vite --config vite.config.ts",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --output text",
    "package:firefox": "bun run build:firefox && bun run lint:firefox && web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "test": "bun test manifest.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "web-ext": "^10.5.0"
  }
}
