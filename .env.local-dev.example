# Optional bootstrap profile for the persistent local development instance.
# Copy this file to .env.local-dev and keep the real API key local. When the
# local D1 has no AI providers, `bun run dev` creates this provider and model.
EDGE_EVER_LOCAL_AI_PROVIDER=openai-compatible
EDGE_EVER_LOCAL_AI_DISPLAY_NAME=OpenAI-compatible
EDGE_EVER_LOCAL_AI_BASE_URL=https://openrouter.ai/api/v1
EDGE_EVER_LOCAL_AI_API_KEY=
EDGE_EVER_LOCAL_AI_MODEL_ID=gpt-4.1-mini
